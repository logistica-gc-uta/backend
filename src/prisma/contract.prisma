// use prisma-8

enum Role {
  ADMIN
  CLIENT
  DRIVER
}

enum RecipientType {
  REGISTERED_CLIENT
  GUEST
}

enum OrderStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum RouteStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum VisitOutcome {
  PENDING
  SUCCESSFUL
  FAILED
}

enum AttemptOutcome {
  SUCCESSFUL
  FAILED
}

enum VisitFailureReason {
  RECIPIENT_ABSENT
  RECIPIENT_REFUSED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())

  driver    Driver?
  orders        Order[] @relation("OrderOwner")
  createdOrders Order[] @relation("OrderCreator")
  uploadedAssets UploadedAsset[] @relation("UploadActor")
}

model Driver {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  vehicle     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  routes      Route[]
}

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  depotLat  Float?
  depotLng  Float?
  createdAt DateTime @default(now())

  routes    Route[]
  orders    Order[]

  @@check(expression: "(\"depotLat\" IS NULL AND \"depotLng\" IS NULL) OR (\"depotLat\" IS NOT NULL AND \"depotLng\" IS NOT NULL AND \"depotLat\" >= -90 AND \"depotLat\" <= 90 AND \"depotLng\" >= -180 AND \"depotLng\" <= 180)", name: "zone_depot_coordinates_valid")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  products    Product[]

  @@check(expression: "length(name) BETWEEN 2 AND 80 AND length(slug) BETWEEN 2 AND 100 AND slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND (description IS NULL OR length(description) <= 300) AND \"sortOrder\" BETWEEN 0 AND 9999", name: "category_catalog_valid")
  @@index([isActive, sortOrder, name])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  priceCents  BigInt?
  sku         String?  @unique
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)
  updatedAt   DateTime @default(now())
  stock       Int      @default(0)
  createdAt   DateTime @default(now())

  orderItems  OrderItem[]
  images      ProductImage[]

  @@check(expression: "stock >= 0 AND (\"priceCents\" IS NULL OR \"priceCents\" BETWEEN 1 AND 9007199254740991)", name: "product_catalog_amount_inventory")
  @@check(expression: "NOT \"isPublished\" OR (\"categoryId\" IS NOT NULL AND \"priceCents\" IS NOT NULL AND sku IS NOT NULL AND description IS NOT NULL AND length(description) BETWEEN 1 AND 2000 AND length(name) BETWEEN 3 AND 160)", name: "product_publish_fields")
  @@index([categoryId, isPublished])
  @@index([isPublished, isFeatured])
}

model ProductImage {
  id          String @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  uploadId    String @unique
  upload      UploadedAsset @relation(fields: [uploadId], references: [id])
  publicId    String
  secureUrl   String
  altText     String
  position    Int
  isPrimary   Boolean @default(false)

  @@unique([productId, position])
  @@index([productId], unique: true, where: "(\"isPrimary\" = true)", name: "one_primary_image_per_product")
  @@check(expression: "position BETWEEN 0 AND 5 AND length(\"altText\") BETWEEN 1 AND 160 AND \"secureUrl\" LIKE 'https://%'", name: "product_image_valid")
}

// Provider object is retained after detach until the audited cleanup succeeds.
model UploadedAsset {
  id             String @id @default(uuid())
  actorId        String
  actor          User @relation("UploadActor", fields: [actorId], references: [id])
  publicId       String @unique
  secureUrl      String?
  format         String
  bytes          Int
  width          Int
  height         Int
  status         String @default("UPLOADING")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  attachedAt     DateTime?
  cleanupAt      DateTime?
  cleanupAttempts Int @default(0)
  lastCleanupError String?
  image          ProductImage?

  @@index([status, expiresAt])
  @@index([actorId])
  @@check(expression: "status IN ('UPLOADING', 'UPLOADED', 'ATTACHED', 'CLEANUP_PENDING', 'DELETED') AND bytes BETWEEN 1 AND 5242880 AND width BETWEEN 1 AND 8192 AND height BETWEEN 1 AND 8192 AND format IN ('jpg', 'png', 'webp') AND \"cleanupAttempts\" >= 0 AND (\"secureUrl\" IS NULL OR \"secureUrl\" LIKE 'https://%') AND (status NOT IN ('UPLOADED', 'ATTACHED') OR \"secureUrl\" IS NOT NULL)", name: "upload_asset_valid")
}

model Route {
  id        String   @id @default(uuid())
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id])
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  // NULL preserves unverified legacy execution; callers explicitly create DRAFT.
  status        RouteStatus?
  startedAt     DateTime?
  completedAt   DateTime?
  returnedAt    DateTime?
  startedById   String?
  startedBy     User? @relation("RouteStartedBy", fields: [startedById], references: [id])
  completedById String?
  completedBy   User? @relation("RouteCompletedBy", fields: [completedById], references: [id])
  returnedById  String?
  returnedBy    User? @relation("RouteReturnedBy", fields: [returnedById], references: [id])

  orders    Order[]

  @@index([driverId])
  @@index([driverId], unique: true, where: "(status = 'IN_PROGRESS')", name: "one_in_progress_route_per_driver")
  @@index([startedById])
  @@index([completedById])
  @@index([returnedById])
}

model Order {
  id                    String      @id @default(uuid())
  userId                String?
  user                  User?       @relation("OrderOwner", fields: [userId], references: [id])
  // NULL means unverifiable history, never an inferred actor or contact snapshot.
  createdById           String?
  createdBy             User?       @relation("OrderCreator", fields: [createdById], references: [id])
  recipientType         RecipientType?
  recipientName         String?
  recipientPhone        String?
  deliveryWindowStart   DateTime?
  deliveryWindowEnd     DateTime?
  zoneId                String
  zone                  Zone        @relation(fields: [zoneId], references: [id])
  routeId               String?
  route                 Route?      @relation(fields: [routeId], references: [id])
  status                OrderStatus @default(PENDING)
  total                 Float       @default(0)
  subtotalCents         BigInt?
  deliveryAddress       String
  scheduledDeliveryDate DateTime?
  stopOrder             Int?
  deliveryLat           Float?
  deliveryLng           Float?
  createdAt             DateTime    @default(now())

  requiresAdministrativeReview Boolean @default(false)
  // Unresolved failed visits are never commercially delivered/cancelled.
  @@check(expression: "NOT \"requiresAdministrativeReview\" OR status NOT IN ('DELIVERED', 'CANCELLED')", name: "failed_order_commercial_hold")

  items                 OrderItem[]

  @@index([userId])
  @@index([createdById])
  @@index([scheduledDeliveryDate])
  @@index([zoneId, status, scheduledDeliveryDate])

  // COALESCE closes SQL CHECK's NULL/unknown bypass for classified rows.
  // Owned unclassified rows keep the existing CLIENT creation path compatible.
  @@check(expression: "COALESCE((\"recipientType\" IS NULL AND \"userId\" IS NOT NULL) OR (\"recipientType\" = 'GUEST' AND \"userId\" IS NULL AND \"createdById\" IS NOT NULL AND \"recipientName\" ~ '[^[:space:]]' AND \"recipientPhone\" ~ '[^[:space:]]') OR (\"recipientType\" = 'REGISTERED_CLIENT' AND \"userId\" IS NOT NULL AND \"createdById\" IS NOT NULL AND \"recipientName\" ~ '[^[:space:]]'), false)", name: "order_recipient_identity_valid")
  // DateTime persists timestamptz: compare business days explicitly, not server TZ.
  @@check(expression: "COALESCE((\"deliveryWindowStart\" IS NULL AND \"deliveryWindowEnd\" IS NULL) OR (\"deliveryWindowStart\" IS NOT NULL AND \"deliveryWindowEnd\" IS NOT NULL AND \"scheduledDeliveryDate\" IS NOT NULL AND \"deliveryWindowStart\" < \"deliveryWindowEnd\" AND \"scheduledDeliveryDate\" >= \"deliveryWindowStart\" AND \"scheduledDeliveryDate\" <= \"deliveryWindowEnd\" AND (\"deliveryWindowStart\" AT TIME ZONE 'America/Guayaquil')::date = (\"deliveryWindowEnd\" AT TIME ZONE 'America/Guayaquil')::date), false)", name: "order_delivery_window_valid")

  @@check(expression: "(\"deliveryLat\" IS NULL AND \"deliveryLng\" IS NULL) OR (\"deliveryLat\" IS NOT NULL AND \"deliveryLng\" IS NOT NULL AND \"deliveryLat\" >= -90 AND \"deliveryLat\" <= 90 AND \"deliveryLng\" >= -180 AND \"deliveryLng\" <= 180)", name: "order_delivery_coordinates_valid")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float
  unitPriceCents BigInt?
}


// Historical positions may be NULL, duplicate or out of range. Never guess them.
model RouteStop {
  id        String @id @default(uuid())
  routeId   String
  route     Route @relation(fields: [routeId], references: [id])
  orderId   String
  order     Order @relation(fields: [orderId], references: [id])
  sequence  Int?
  outcome   VisitOutcome?
  isLegacy  Boolean @default(false)
  createdAt DateTime?

  @@unique([routeId, orderId])
  @@index([orderId])
  @@index([routeId, sequence], unique: true, where: "(NOT \"isLegacy\" AND sequence IS NOT NULL)", name: "verified_route_stop_sequence")
}

// Append-only enforcement and actor authorization are introduced in T1c/T3.
model DeliveryAttempt {
  id             String @id @default(uuid())
  stopId         String
  stop           RouteStop @relation(fields: [stopId], references: [id])
  driverId       String
  driver         Driver @relation(fields: [driverId], references: [id])
  recordedAt     DateTime @default(now())
  outcome        AttemptOutcome
  failureReason  VisitFailureReason?
  context        Json
  idempotencyKey String
  requestPayload Json

  @@unique([stopId, idempotencyKey])
  @@index([driverId])
  @@check(expression: "(outcome = 'FAILED' AND \"failureReason\" IS NOT NULL) OR (outcome = 'SUCCESSFUL' AND \"failureReason\" IS NULL)", name: "delivery_attempt_failure_reason_pairing")
}

// Legacy associations remain on unverified routes, not manufactured claims.
model OrderClaim {
  id         String @id @default(uuid())
  orderId    String
  order      Order @relation(fields: [orderId], references: [id])
  routeId    String
  route      Route @relation(fields: [routeId], references: [id])
  claimedAt  DateTime?
  releasedAt DateTime?

  @@index([orderId], unique: true, where: "(\"releasedAt\" IS NULL)", name: "active_order_claim")
  @@index([routeId])
}

model DriverReservation {
  id         String @id @default(uuid())
  driverId   String
  driver     Driver @relation(fields: [driverId], references: [id])
  routeId    String
  route      Route @relation(fields: [routeId], references: [id])
  reservedAt DateTime?
  releasedAt DateTime?

  @@index([driverId], unique: true, where: "(\"releasedAt\" IS NULL)", name: "active_driver_reservation")
  @@index([routeId])
  @@index([routeId], unique: true, where: "(\"releasedAt\" IS NULL)", name: "one_active_reservation_per_route")
}

// Audited regularization is distinct from completion and physical return events.
model LegacyRouteReconciliation {
  id                String @id @default(uuid())
  routeId           String
  route             Route @relation(fields: [routeId], references: [id])
  administratorId   String
  administrator     User @relation(fields: [administratorId], references: [id])
  recordedAt        DateTime @default(now())
  reason            String
  evidence          Json
  releaseDriverHold Boolean @default(false)

  @@index([routeId])
  @@index([routeId], unique: true, name: "one_reconciliation_per_route")
  @@index([administratorId])
}

// Idempotent ADMIN decisions; no temporary proposal persistence.
model DispatchIntervention {
  id         String @id @default(uuid())
  requestId  String @unique
  actorId    String
  actor      User @relation(fields: [actorId], references: [id])
  orderId    String?
  order      Order? @relation(fields: [orderId], references: [id])
  routeId    String?
  route      Route? @relation(fields: [routeId], references: [id])
  action     String
  reason     String
  outcome    String
  recordedAt DateTime @default(now())
  payload    Json
  result     Json

  @@index([orderId])
  @@index([routeId])
  @@check(expression: "action IN ('CONFIRM', 'REJECT', 'REORDER', 'MOVE', 'REASSIGN_DRIVER', 'PRIORITIZE', 'CONTACT', 'RESCHEDULE') AND outcome IN ('APPLIED', 'REJECTED', 'FAILED') AND length(trim(reason)) BETWEEN 1 AND 500", name: "dispatch_audit_valid")
}
