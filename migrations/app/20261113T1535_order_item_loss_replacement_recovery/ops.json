        "description": "create table \"orderItemLoss\"",
        "sql": "CREATE TABLE \"public\".\"orderItemLoss\" (\n  \"attemptId\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"declarationRequestId\" text NOT NULL,\n  \"declaredAt\" timestamptz NOT NULL,\n  \"declaredById\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"orderId\" text NOT NULL,\n  \"orderItemId\" text NOT NULL,\n  \"productId\" text NOT NULL,\n  \"recoveredAt\" timestamptz,\n  \"recoveredById\" text,\n  \"recoveryCondition\" text,\n  \"recoveryRequestId\" text,\n  \"replacementPreparedAt\" timestamptz,\n  \"replacementPreparedById\" text,\n  \"replacementRequestId\" text,\n  \"unitNumber\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"order_item_loss_recovery_consistent_6470312d\" CHECK ((\"recoveredAt\" IS NULL AND \"recoveredById\" IS NULL AND \"recoveryCondition\" IS NULL AND \"recoveryRequestId\" IS NULL) OR (\"recoveredAt\" IS NOT NULL AND \"recoveredById\" IS NOT NULL AND \"recoveryCondition\" IN ('SELLABLE', 'DAMAGED') AND \"recoveryRequestId\" IS NOT NULL AND \"recoveredAt\" >= \"declaredAt\")),\n  CONSTRAINT \"order_item_loss_replacement_consistent_90323337\" CHECK ((\"replacementPreparedAt\" IS NULL AND \"replacementPreparedById\" IS NULL AND \"replacementRequestId\" IS NULL) OR (\"replacementPreparedAt\" IS NOT NULL AND \"replacementPreparedById\" IS NOT NULL AND \"replacementRequestId\" IS NOT NULL AND \"replacementPreparedAt\" >= \"declaredAt\")),\n  CONSTRAINT \"order_item_loss_unit_positive_861d7482\" CHECK (\"unitNumber\" >= 1)\n)",
        "params": []
      }
    ],
