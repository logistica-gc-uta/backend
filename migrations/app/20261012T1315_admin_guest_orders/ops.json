    "id": "checkConstraint.order.order_delivery_window_valid_f5c8ac7d",
    "label": "Add check constraint \"order_delivery_window_valid_f5c8ac7d\" on \"order\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "checkConstraint",
        "name": "order_delivery_window_valid_f5c8ac7d",
        "table": "order"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"order_delivery_window_valid_f5c8ac7d\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "order_delivery_window_valid_f5c8ac7d",
          "public",
          "\"public\".\"order\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add check constraint \"order_delivery_window_valid_f5c8ac7d\"",
        "sql": "ALTER TABLE \"public\".\"order\" ADD CONSTRAINT \"order_delivery_window_valid_f5c8ac7d\" CHECK (COALESCE((\"deliveryWindowStart\" IS NULL AND \"deliveryWindowEnd\" IS NULL) OR (\"deliveryWindowStart\" IS NOT NULL AND \"deliveryWindowEnd\" IS NOT NULL AND \"scheduledDeliveryDate\" IS NOT NULL AND \"deliveryWindowStart\" < \"deliveryWindowEnd\" AND \"scheduledDeliveryDate\" >= \"deliveryWindowStart\" AND \"scheduledDeliveryDate\" <= \"deliveryWindowEnd\" AND (\"deliveryWindowStart\" AT TIME ZONE 'America/Guayaquil')::date = (\"deliveryWindowEnd\" AT TIME ZONE 'America/Guayaquil')::date), false))"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"order_delivery_window_valid_f5c8ac7d\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "order_delivery_window_valid_f5c8ac7d",
          "public",
          "\"public\".\"order\""
        ]
      }
    ]
