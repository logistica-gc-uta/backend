      {
        "description": "create table \"driverAbsence\"",
        "sql": "CREATE TABLE \"public\".\"driverAbsence\" (\n  \"cancelReason\" text,\n  \"cancelledAt\" timestamptz,\n  \"cancelledById\" text,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" text NOT NULL,\n  \"driverId\" text NOT NULL,\n  \"endDate\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"reason\" text,\n  \"startDate\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"driver_absence_cancellation_consistent_63a24d0f\" CHECK ((\"cancelledAt\" IS NULL AND \"cancelledById\" IS NULL AND \"cancelReason\" IS NULL) OR (\"cancelledAt\" IS NOT NULL AND \"cancelledById\" IS NOT NULL AND (\"cancelReason\" IS NULL OR length(\"cancelReason\") BETWEEN 1 AND 300))),\n  CONSTRAINT \"driver_absence_valid_d56413e5\" CHECK (\"startDate\" ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' AND \"endDate\" ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' AND \"endDate\" >= \"startDate\" AND (reason IS NULL OR length(reason) BETWEEN 1 AND 300))\n)",
        "params": []
      }
    ],
    "postcheck": [
