# Copy this file to `.env` for LOCAL DEVELOPMENT only. Every value below is a development placeholder:
# a deployed backend (NODE_ENV=production or demo) refuses to start with them. See docs/issue-53-production-config.md.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# development | test | demo | production. Undefined is treated as development (with a warning).
NODE_ENV=development
DATABASE_URL="postgresql://logistica_user:logistica_password123@localhost:5432/logistica_db?schema=public"
# Development placeholder. Deployed: at least 32 random characters, kept in a secret manager (never in git).
# Left empty in development, the backend uses a random per-process secret (tokens stop working on restart).
JWT_SECRET="super_secret_dev_key"
JWT_EXPIRES_IN="1d"
PORT=3000
# Exact browser origins allowed by CORS (comma-separated; no wildcard, no path). REQUIRED when deployed;
# in development, leaving it empty keeps CORS open so Flutter web and local frontends keep working.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger UI at /api/docs. Default: on in development/test, off in demo/production unless set to true.
# SWAGGER_ENABLED=true
# Exact browser origins allowed for realtime Socket.IO (comma-separated; no wildcard).
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Road engine (#47). Leave ROAD_ENGINE empty to keep straight-line (Haversine) distances.
# With ROAD_ENGINE=OSRM every route proposal uses the road network and FAILS if the engine does not answer
# (no silent fallback). Use a LOCAL or private instance; do not use the public demo server in production.
# See docs/osrm/README.md and docs/issue-47-road-engine.md.
ROAD_ENGINE=
# OSRM_BASE_URL=http://127.0.0.1:5001
# OSRM_PROFILE=car
# OSRM_TIMEOUT_MS=5000
# OSRM_MAX_POINTS=300
# OSRM_CONCURRENCY=4
# OSRM_MAX_SNAP_DISTANCE_M=500
