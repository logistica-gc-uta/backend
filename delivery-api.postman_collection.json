          }
        }
      ]
    },
    {
      "name": "03-Products",
      "description": "Catálogo de productos e inventario",
      "item": [
        {
          "name": "GET List Available Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Obtiene la lista de productos cuyo stock es mayor a 0."
          }
        },
        {
          "name": "POST Create Product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Webcam Full HD 1080p\",\n  \"description\": \"Cámara con enfoque automático y micrófono dual\",\n  \"price\": 45.00,\n  \"stock\": 35\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Registra un nuevo producto en el catálogo (Requiere rol ADMIN)."
          }
        },
        {
          "name": "PATCH Update Stock",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:productId/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":productId", "stock"],
              "variable": [
                {
                  "key": "productId",
                  "value": "5bfab217-48b3-4117-987d-f115256e6377",
                  "description": "ID del producto a actualizar"
                }
              ]
            },
            "description": "Actualiza el inventario disponible de un producto (Requiere rol ADMIN)."
          }
        }
      ]
    },
    {
      "name": "04-Orders",
      "description": "Creación atómica de pedidos, descuento de stock y actualización de estados",
      "item": [
        {
          "name": "POST Create Order",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zoneId\": \"2f782f43-6ec2-41ff-875f-c4c93d303fa4\",\n  \"items\": [\n    {\n      \"productId\": \"5bfab217-48b3-4117-987d-f115256e6377\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"03c438ea-56a6-4899-99df-9d86a440ad22\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Crea una nueva orden para el cliente autenticado, descuenta stock de los productos y establece el estado inicial PENDING (Requiere rol CLIENT)."
          }
        },
        {
          "name": "GET My Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            },
            "description": "Lista los pedidos realizados por el cliente autenticado con sus respectivos items (Requiere rol CLIENT)."
          }
        },
        {
          "name": "GET All Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Consulta todas las órdenes en el sistema con detalle de usuario, zona e items (Requiere rol ADMIN)."
          }
        },
        {
          "name": "PATCH Update Order Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/:orderId/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":orderId", "status"],
              "variable": [
                {
                  "key": "orderId",
                  "value": "replace-with-actual-order-id",
                  "description": "ID del pedido a actualizar"
                }
              ]
            },
            "description": "Actualiza el estado de un pedido a IN_TRANSIT o DELIVERED (Requiere rol DRIVER o ADMIN)."
          }
        }
      ]
    },
    {
      "name": "05-Routes (Core Business Rule)",
      "description": "Asignación de rutas y verificación de la regla de negocio: máximo 4 pedidos por repartidor",
      "item": [
        {
          "name": "POST Assign Route - Success (<= 4 orders)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"replace-with-driver-id\",\n  \"zoneId\": \"2f782f43-6ec2-41ff-875f-c4c93d303fa4\",\n  \"orderIds\": [\n    \"order-id-1\",\n    \"order-id-2\",\n    \"order-id-3\",\n    \"order-id-4\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routes/assign",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "assign"]
            },
            "description": "Asignación válida: crea la ruta y asocia de 1 hasta 4 pedidos en estado PENDING a un repartidor disponible (Requiere rol ADMIN)."
          }
        },
        {
          "name": "POST Assign Route - Reject (> 4 orders)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"replace-with-driver-id\",\n  \"zoneId\": \"2f782f43-6ec2-41ff-875f-c4c93d303fa4\",\n  \"orderIds\": [\n    \"order-id-1\",\n    \"order-id-2\",\n    \"order-id-3\",\n    \"order-id-4\",\n    \"order-id-5\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routes/assign",
              "host": ["{{baseUrl}}"],
              "path": ["routes", "assign"]
            },
            "description": "Intento de asignación inválido: envía 5 pedidos para provocar el error 400 Bad Request ('No se pueden asignar más de 4 pedidos a una ruta/repartidor')."
          }
        },
        {
          "name": "GET List Routes",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
