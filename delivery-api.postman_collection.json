            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routes",
              "host": ["{{baseUrl}}"],
              "path": ["routes"]
            },
            "description": "Lista todas las rutas creadas junto con su repartidor, zona y pedidos asignados (Requiere rol ADMIN)."
          }
        }
      ]
    }
